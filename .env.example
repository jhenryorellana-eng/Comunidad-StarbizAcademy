# Supabase (proyecto: pduqjkdoxocdrbhounen · https://pduqjkdoxocdrbhounen.supabase.co)
# Copia las cadenas exactas desde: Supabase Dashboard -> Connect -> ORMs -> Prisma
# DATABASE_URL = conexion pooled (puerto 6543, transaction mode)
# DIRECT_URL   = conexion directa/session (puerto 5432)
#
# connection_limit=8: con 1, Prisma serializa TODAS las consultas en una sola
# conexión. Medido: 5 count() tardaban lo mismo en paralelo (2588 ms) que en
# serie (2593 ms).
DATABASE_URL="postgresql://postgres.pduqjkdoxocdrbhounen:[TU-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=8"
DIRECT_URL="postgresql://postgres.pduqjkdoxocdrbhounen:[TU-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth
JWT_SECRET="[GENERA-UN-SECRETO-LARGO-Y-ALEATORIO]"
AUTH_COOKIE_NAME="sba_session"

# Credenciales del admin usadas por el seed (opcional)
# ADMIN_EMAIL="admin@starbizacademy.com"
# ADMIN_PASSWORD="..."

# ─────────────────────────────────────────────────────────────────────────────
# URL pública del sitio
#
# En local: DÉJALA FUERA. Sin valor cae a http://localhost:3000, que es lo
# correcto aquí — con el dominio real, pagar en local te devolvería a producción.
#
# En producción con dominio propio: OBLIGATORIA. Vercel sólo conoce el
# `.vercel.app`, y de esta variable salen las URLs de vuelta del pago y las
# miniaturas al compartir.
#
# O con valor, o fuera. Declararla vacía no es lo mismo que no declararla.
# NEXT_PUBLIC_SITE_URL="https://comunidad.starbizacademy.com"
# ─────────────────────────────────────────────────────────────────────────────

# Stripe (pago del Bootcamp Utah 2027)
# Dashboard -> Desarrolladores -> Claves de API.
# Si STRIPE_SECRET_KEY queda vacía, el checkout se desactiva y el CTA cae a
# WhatsApp — nada se rompe.
STRIPE_SECRET_KEY=""

# Local:      stripe listen --forward-to localhost:3000/api/stripe/webhook
# Producción: Dashboard -> Desarrolladores -> Webhooks -> + Añadir endpoint
#             Eventos: checkout.session.completed, charge.refunded
STRIPE_WEBHOOK_SECRET=""

# No hace falta STRIPE_PUBLISHABLE_KEY: con Checkout alojado el navegador nunca
# carga Stripe.js, así que esa clave no la usa ninguna línea del código.
